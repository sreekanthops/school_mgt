# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default — fine for single-server deployments with moderate load)
DATABASE_URL=sqlite:////opt/school/db/school.db

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://school_user:CHANGE_ME@localhost:5432/school_db

# ── JWT ───────────────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_generate_a_random_secret

# Session lifetime in minutes (default 60)
JWT_EXPIRE_MINUTES=60

# ── Academic year ─────────────────────────────────────────────────────────────
CURRENT_ACADEMIC_YEAR=2025-26

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Set to your domain(s) in production.
# With Nginx proxying everything through one origin you only need the one below.
CORS_ORIGINS=https://school.example.com

# ── SMTP (Gmail App Password — for owner password-reset emails) ───────────────
# Leave blank to disable email recovery (security questions and superadmin remain available).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your-gmail@gmail.com

# ── Optional LLM (Smart Import + Chatbot rephrasing) ─────────────────────────
# Must be an https:// URL. Leave blank to disable.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
