# Copy to .env (never commit .env). Seeding auto-generates missing passwords and JWT_SECRET into .env.
DATABASE_URL=sqlite:///./school.db
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
CURRENT_ACADEMIC_YEAR=2025-26
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Demo-seed logins (generated if left empty)
SUPERADMIN_PASSWORD=
ADMIN_PASSWORD=
TEACHER_PASSWORD=
STUDENT_PASSWORD=
OWNER2_PASSWORD=
# Optional LLM layer for the chatbot (must be an https endpoint, OpenAI-compatible)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
