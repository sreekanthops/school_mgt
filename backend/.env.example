# Copy to .env (never commit .env). Seeding auto-generates missing passwords and JWT_SECRET into .env.
DATABASE_URL=sqlite:///./school.db
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
CURRENT_ACADEMIC_YEAR=2025-26
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Demo-seed logins (generated if left empty)
SUPERADMIN_PASSWORD=
ADMIN_PASSWORD=
TEACHER_PASSWORD=
STUDENT_PASSWORD=
OWNER2_PASSWORD=
# Optional LLM layer (must be an https endpoint, OpenAI-compatible). Used by the chatbot (answers it already
# computed) and by Smart Import (column HEADINGS only, never student or staff rows)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional SMTP for owner password-reset emails. Use a Gmail App Password (not your real Gmail password).
# Create one at: https://myaccount.google.com/apppasswords
# Leave empty to disable email recovery — security questions and superadmin reset remain available.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
